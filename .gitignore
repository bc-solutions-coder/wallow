# Build outputs
bin/
obj/
out/
**/bin\\Debug/
**/bin\\Release/
**/obj\\Debug/
**/obj\\Release/
# TanStack Start / Nitro build artifacts (`vite build` emits .output, and both
# tools keep scratch state beside it).
.output/
.nitro/
.tanstack/
# Turborepo local cache and run scratch
.turbo/

# IDE
.idea/
.vs/
.run/
.serena/
*.user
*.suo
*.userprefs
*.sln.docstates

# Environment
.env
*.local

# Seed data (environment overrides contain real credentials)
seed.*.json
!seed.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test results
TestResults/
test-results/
coverage/
coverage-report/
coverage-results/
playwright-report/
__screenshots__/
.vitest-attachments/
# Vitest JSON reporter output (--outputFile.json), written per package by an
# instrumented `pnpm -r test` run and never worth committing.
.vitest-run.json

# NuGet
*.nupkg

# Docker
docker-compose.override.yml
docker-compose.override.local.yml
# The working ingress config (real domain, trusted_proxies ranges); the
# committed reference is docker/caddy/Caddyfile.example.
docker/caddy/Caddyfile

# Environment files (keep examples, ignore actual secrets)
docker/.env
docker/.env.production
.env.local
.env.*.local

# Worktrees
.worktrees/

# Qodana
.qodana/
.qodana-cache/
.qodana-results/

# Local database files
*.db
.superpowers/

# Duplicate root manifest (real one is .config/dotnet-tools.json)
/dotnet-tools.json


# DocFX generated output
.docfx/

# Specs and superpowers docs (local only). docs/plans/ IS tracked — issues cite
# plan paths as their justification, and a fresh clone needs to be able to read them.
docs/specs/
docs/superpowers/
docs/claude/
docs/audits/


# EF migration bundles (generated by the scripts/e2e.sh stack)
bundles/

# DataProtection keys (local dev fallback)
.keys/

# Node / npm (SDK workspace + examples)
node_modules/
dist/

# Storybook static build (packages/ui)
storybook-static/

# Playwright MCP debug artifacts (console logs, page snapshots)
.playwright-mcp/

# Lint-gate fixtures (written and deleted per assertion by src/lint-gate.test.ts).
# Gitignored so oxlint skips them while WALKING a directory but still lints one
# handed to it explicitly — which is what keeps a fixture leaked by a crashed run
# from failing `pnpm lint` for everyone.
__lintfixtures__/

# The oxlint guardrail spec's mirror trees (packages/sdk/src/oxlint-guardrails.test.ts).
# In-repo rather than in os.tmpdir() so the copied root config can resolve its
# jsPlugins specifier through the repo's node_modules.
.lint-mirror/
