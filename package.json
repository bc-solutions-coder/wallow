{
  "name": "wallow-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "backend": "dotnet run --project api/src/Wallow.AppHost",
    "backend:infra": "cd docker && docker compose up -d",
    "backend:infra:down": "cd docker && docker compose down",
    "secrets:prod": "./scripts/prod-secrets.sh",
    "dev": "turbo run dev --filter @bc-solutions-coder/wallow-web --filter @bc-solutions-coder/wallow-auth",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint apps packages --ignore-pattern '**/*.test.*' --ignore-pattern '**/*.stories.tsx' --deny-warnings",
    "lint:fix": "oxlint apps packages --ignore-pattern '**/*.test.*' --ignore-pattern '**/*.stories.tsx' --fix",
    "lint:tests": "./scripts/lint-tests.sh",
    "lint:tests:fix": "./scripts/lint-tests.sh --fix",
    "lint:manifests": "sherif",
    "lint:deps": "knip",
    "lint:env": "./scripts/check-env.sh",
    "lint:actions": "./scripts/lint-actions.sh",
    "format": "oxfmt --write apps packages package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.build.base.json .oxlintrc.json .oxfmtrc.json turbo.jsonc",
    "format:check": "oxfmt --check apps packages package.json pnpm-workspace.yaml tsconfig.base.json tsconfig.build.base.json .oxlintrc.json .oxfmtrc.json turbo.jsonc",
    "check:exports": "./scripts/check-exports.sh",
    "check": "pnpm format:check && pnpm lint && pnpm lint:tests && pnpm lint:manifests && pnpm lint:deps && pnpm lint:env && turbo run build typecheck && pnpm test && pnpm check:exports",
    "prepare": "husky"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@bc-solutions-coder/lint": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^6.31.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.22",
    "sherif": "^1.13.0",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@11.24.0"
}
