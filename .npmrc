engine-strict=true

@bc-solutions-coder:registry=https://npm.pkg.github.com

# No `//npm.pkg.github.com/:_authToken` line here on purpose. pnpm refuses to
# expand environment variables in registry credentials that come from a project
# .npmrc, because that file is committed and could leak the secret to an
# attacker-controlled registry — so the line authenticates nothing and only
# prints a warning on every pnpm invocation. Nothing in this workspace needs it:
# every @bc-solutions-coder dependency is `workspace:*` and resolves locally.
# Publishing takes its credential from a source pnpm does expand — setup-node
# writes a user-level .npmrc and points NPM_CONFIG_USERCONFIG at it (see
# .github/workflows/package-publish.yml). To install a published
# @bc-solutions-coder package outside this workspace, put the credential in
# ~/.npmrc or run:
#   pnpm config set "//npm.pkg.github.com/:_authToken" <token>
