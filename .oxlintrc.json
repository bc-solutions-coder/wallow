{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "warn",
    "style": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-ternary": "off",
    "capitalized-comments": "off",
    "unicorn/no-null": "off",
    "typescript/no-inferrable-types": "off",
    "func-style": "off",
    "sort-keys": "off",
    "sort-imports": "off",
    "prefer-destructuring": "off",
    "no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "id-length": "off",
    "init-declarations": "off",
    "max-lines": "off",
    "max-statements": "off",
    "max-params": "off",
    "max-lines-per-function": "off",
    "no-duplicate-imports": ["warn", { "allowSeparateTypeImports": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@bc-solutions-coder/sdk",
            "importNames": [
              "client",
              "configureBffClient",
              "configureSsrClient",
              "configureWallowClient",
              "createAuthClient",
              "createConfiguredOnce",
              "createMfaClient",
              "getSsrRequestContext",
              "resolveSsrFetchOrigin",
              "setSsrRequestContextResolver",
              "unwrap",
              "wireSsrCookieInterceptor"
            ],
            "message": "Deleted with the module-global client. Build a per-request instance with createWallowSdk({ baseUrl }) and pass { client: sdk.client } to the generated operations; errors already arrive as WallowError, so nothing needs unwrapping."
          },
          {
            "name": "@bc-solutions-coder/sdk/query",
            "importNames": [
              "appsQueries",
              "authQueries",
              "ensureQueryBootstrapped",
              "inquiriesQueries",
              "mfaQueries",
              "organizationsQueries",
              "queryKeys",
              "registerQueryBootstrap",
              "resetQueryBootstrapForTests",
              "settingsQueries",
              "userQueries"
            ],
            "message": "The hand-written query slices and their key registry are deleted. Use the generated {op}Options()/{op}Mutation()/{op}QueryKey(), and sweep with queriesForOperation()/queriesWithTag()."
          },
          {
            "name": "@tanstack/react-query",
            "message": "Import it from @bc-solutions-coder/query instead. The facade owns the pinned version and the shared client defaults, and keeps one QueryClient context instance across the workspace so a provider mounted in one package is the one every other package's hooks read."
          },
          {
            "name": "@bc-solutions-coder/web-shell",
            "message": "@bc-solutions-coder/web-shell is deleted. createQueryClient now ships from @bc-solutions-coder/query, which also re-exports the react-query surface it used to wrap."
          }
        ],
        "patterns": [
          {
            "group": [
              "@bc-solutions-coder/sdk/dist",
              "@bc-solutions-coder/sdk/dist/**",
              "@bc-solutions-coder/sdk/src",
              "@bc-solutions-coder/sdk/src/**",
              "@bc-solutions-coder/sdk/generated",
              "@bc-solutions-coder/sdk/generated/**"
            ],
            "message": "Import a published entry point instead: @bc-solutions-coder/sdk, /server, /server/passthrough, or /query. The dist and src layouts are internals and are not covered by the package's export contract."
          },
          {
            "group": ["**/lib/wallow-sdk", "**/lib/wallow-auth-sdk", "**/lib/sdk"],
            "message": "The per-app SDK facade singletons are deleted. Read the request-scoped sdk off the router context (useRouteContext({ from: '__root__' }).sdk) instead of a module-global facade."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/generated/**",
    "packages/sdk/src/generated/**",
    "**/routeTree.gen.ts",
    "**/.output/**",
    "**/.nitro/**",
    "**/.tanstack/**"
  ],
  "overrides": [
    {
      "files": ["tools/**/*.{ts,js}"],
      "rules": {
        "no-magic-numbers": ["warn", { "ignore": [0, 1] }]
      }
    },
    {
      "files": ["apps/wallow-web/**/*.{ts,tsx}"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
        "no-magic-numbers": ["warn", { "ignore": [0, 1] }]
      }
    },
    {
      "files": ["apps/wallow-auth/**/*.{ts,tsx}"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
        "no-magic-numbers": ["warn", { "ignore": [0, 1] }]
      }
    },
    {
      "files": ["apps/examples/**/*.{ts,tsx}"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "kebabCase": true, "pascalCase": true } }],
        "no-magic-numbers": ["warn", { "ignore": [0, 1] }]
      }
    },
    {
      "files": ["apps/**/src/features/*/api.test.ts", "packages/sdk/src/**/index.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "packages/query/**",
        "packages/sdk/src/route-context.ts",
        "packages/sdk/src/route-context.test.ts",
        "packages/sdk/src/query/invalidations.ts",
        "packages/sdk/src/generated-query-surface.test.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@bc-solutions-coder/sdk",
                "importNames": [
                  "client",
                  "configureBffClient",
                  "configureSsrClient",
                  "configureWallowClient",
                  "createAuthClient",
                  "createConfiguredOnce",
                  "createMfaClient",
                  "getSsrRequestContext",
                  "resolveSsrFetchOrigin",
                  "setSsrRequestContextResolver",
                  "unwrap",
                  "wireSsrCookieInterceptor"
                ],
                "message": "Deleted with the module-global client. Build a per-request instance with createWallowSdk({ baseUrl }) and pass { client: sdk.client } to the generated operations; errors already arrive as WallowError, so nothing needs unwrapping."
              },
              {
                "name": "@bc-solutions-coder/sdk/query",
                "importNames": [
                  "appsQueries",
                  "authQueries",
                  "ensureQueryBootstrapped",
                  "inquiriesQueries",
                  "mfaQueries",
                  "organizationsQueries",
                  "queryKeys",
                  "registerQueryBootstrap",
                  "resetQueryBootstrapForTests",
                  "settingsQueries",
                  "userQueries"
                ],
                "message": "The hand-written query slices and their key registry are deleted. Use the generated {op}Options()/{op}Mutation()/{op}QueryKey(), and sweep with queriesForOperation()/queriesWithTag()."
              },
              {
                "name": "@bc-solutions-coder/web-shell",
                "message": "@bc-solutions-coder/web-shell is deleted. createQueryClient now ships from @bc-solutions-coder/query, which also re-exports the react-query surface it used to wrap."
              }
            ],
            "patterns": [
              {
                "group": [
                  "@bc-solutions-coder/sdk/dist",
                  "@bc-solutions-coder/sdk/dist/**",
                  "@bc-solutions-coder/sdk/src",
                  "@bc-solutions-coder/sdk/src/**",
                  "@bc-solutions-coder/sdk/generated",
                  "@bc-solutions-coder/sdk/generated/**"
                ],
                "message": "Import a published entry point instead: @bc-solutions-coder/sdk, /server, /server/passthrough, or /query. The dist and src layouts are internals and are not covered by the package's export contract."
              },
              {
                "group": ["**/lib/wallow-sdk", "**/lib/wallow-auth-sdk", "**/lib/sdk"],
                "message": "The per-app SDK facade singletons are deleted. Read the request-scoped sdk off the router context (useRouteContext({ from: '__root__' }).sdk) instead of a module-global facade."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.*", "**/*.stories.tsx"],
      "rules": {
        "no-await-in-loop": "off",
        "no-magic-numbers": "off",
        "sort-keys": "off",
        "require-unicode-regexp": "off",
        "require-await": "off",
        "no-shadow": "off",
        "prefer-named-capture-group": "off",
        "unicorn/prefer-response-static-json": "off",
        "unicorn/numeric-separators-style": "off",
        "unicorn/catch-error-name": "off",
        "unicorn/prefer-import-meta-properties": "off",
        "unicorn/no-useless-undefined": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/relative-url-style": "off",
        "typescript/consistent-type-imports": "off",
        "typescript/consistent-generic-constructors": "off",
        "typescript/array-type": "off",
        "react/jsx-props-no-spreading": "off",
        "vitest/valid-expect": "off",
        "vitest/expect-expect": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off",
        "vitest/no-importing-vitest-globals": "off",
        "vitest/no-conditional-in-test": "off",
        "vitest/no-hooks": "off",
        "vitest/no-duplicate-hooks": "off",
        "vitest/prefer-hooks-in-order": "off",
        "vitest/require-hook": "off",
        "vitest/require-top-level-describe": "off",
        "vitest/max-expects": "off",
        "vitest/prefer-lowercase-title": "off",
        "vitest/prefer-describe-function-title": "off",
        "vitest/prefer-expect-assertions": "off",
        "vitest/prefer-strict-equal": "off",
        "vitest/prefer-strict-boolean-matchers": "off",
        "vitest/prefer-to-be": "off",
        "vitest/prefer-to-be-truthy": "off",
        "vitest/prefer-to-be-falsy": "off",
        "vitest/prefer-to-have-length": "off",
        "vitest/prefer-expect-resolves": "off",
        "vitest/prefer-expect-type-of": "off",
        "vitest/prefer-called-once": "off",
        "vitest/prefer-called-with": "off",
        "vitest/prefer-mock-return-shorthand": "off",
        "vitest/prefer-import-in-mock": "off",
        "vitest/prefer-each": "off",
        "vitest/no-alias-methods": "off"
      }
    }
  ]
}
