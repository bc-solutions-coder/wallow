{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  // Load-bearing: `extends` is what carries the root's plugin registration and its
  // pedantic/style categories down here. Drop it and fork-smoke silently falls back to
  // oxlint's defaults — still green, but no longer linting what the repo lints.
  "extends": ["../../.oxlintrc.json"],
  "rules": {
    // RE-DECLARED, not switched off. This is the root's `no-restricted-imports` minus the
    // `@tanstack/react-query` ban: `@bc-solutions-coder/query` is private and unpublished, so
    // out here `src/router.tsx` genuinely has to build its `QueryClient` from the real package.
    // oxlint has no per-name partial disable and a re-declaration REPLACES rather than merges,
    // so every ban this template still wants is restated below. Setting the rule "off" instead
    // would reopen all of them and silence exactly the SDK-exports regressions fork-smoke exists
    // to catch.
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@bc-solutions-coder/sdk",
            "importNames": [
              "client",
              "configureBffClient",
              "configureSsrClient",
              "configureWallowClient",
              "createAuthClient",
              "createConfiguredOnce",
              "createMfaClient",
              "getSsrRequestContext",
              "resolveSsrFetchOrigin",
              "setSsrRequestContextResolver",
              "unwrap",
              "wireSsrCookieInterceptor"
            ],
            // The module-global SDK client and its configure/unwrap helpers.
            "message": "Deleted with the module-global client. Build a per-request instance with createWallowSdk({ baseUrl }) and pass { client: sdk.client } to the generated operations; errors already arrive as WallowError, so nothing needs unwrapping."
          },
          {
            "name": "@bc-solutions-coder/sdk/query",
            "importNames": [
              "appsQueries",
              "authQueries",
              "ensureQueryBootstrapped",
              "inquiriesQueries",
              "mfaQueries",
              "organizationsQueries",
              "queryKeys",
              "registerQueryBootstrap",
              "resetQueryBootstrapForTests",
              "settingsQueries",
              "userQueries"
            ],
            // The hand-written query slices, superseded by the generated per-operation artifacts.
            "message": "The hand-written query slices and their key registry are deleted. Use the generated {op}Options()/{op}Mutation()/{op}QueryKey(), and sweep with queriesForOperation()/queriesWithTag()."
          },
          {
            "name": "@bc-solutions-coder/web-shell",
            "message": "@bc-solutions-coder/web-shell is deleted. createQueryClient now ships from @bc-solutions-coder/query, which also re-exports the react-query surface it used to wrap."
          }
        ],
        "patterns": [
          {
            // Deep imports past the export map — the layout under them is an internal.
            "group": [
              "@bc-solutions-coder/sdk/dist",
              "@bc-solutions-coder/sdk/dist/**",
              "@bc-solutions-coder/sdk/src",
              "@bc-solutions-coder/sdk/src/**",
              "@bc-solutions-coder/sdk/generated",
              "@bc-solutions-coder/sdk/generated/**"
            ],
            "message": "Import a published entry point instead: @bc-solutions-coder/sdk, /server, /server/passthrough, or /query. The dist and src layouts are internals and are not covered by the package's export contract."
          },
          {
            "group": ["**/lib/wallow-sdk", "**/lib/wallow-auth-sdk", "**/lib/sdk"],
            "message": "The per-app SDK facade singletons are deleted. Read the request-scoped sdk off the router context (useRouteContext({ from: '__root__' }).sdk) instead of a module-global facade."
          }
        ]
      }
    ]
  }
}
