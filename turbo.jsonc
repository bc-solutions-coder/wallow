{
  "$schema": "https://turborepo.dev/schema.json",
  // "stream" keeps CI logs greppable and linear. The interactive TUI would be
  // nicer locally, but a single mode means local and CI output match.
  "ui": "stream",
  // The root package.json, the lockfile, and the source of any internal package
  // the root depends on (here: @bc-solutions-coder/lint) are ALWAYS in the
  // global hash and must not be listed. These are the shared files turbo cannot
  // infer, and the list is deliberately short: every entry busts build,
  // typecheck and test across all 16 members.
  //
  // NOT listed, on purpose: .oxlintrc.json and .oxfmtrc.json. Turbo runs
  // neither oxlint nor oxfmt - those stay root scripts (design §1) - so hashing
  // them would invalidate the whole workspace for a lint-rule tweak that cannot
  // change a single build output.
  "globalDependencies": ["tsconfig.base.json", "tsconfig.build.base.json", ".nvmrc"],
  // Deliberately NOT including CI: hashing it would give CI runners and laptops
  // different keys for identical inputs and defeat the shared remote cache. CI
  // is in turbo's built-in passthrough set, so tasks still see it.
  "globalEnv": ["NODE_ENV"],
  // apiUrl deliberately stays out of the repo: the cache hostname arrives via
  // the TURBO_API env var (a GitHub Actions secret in CI, a shell export on a
  // laptop), alongside TURBO_TEAM and TURBO_TOKEN. With those unset the block
  // is inert — verified on Wallow-m4u7 — so cloning without credentials costs
  // nothing. turbo sends only `Authorization: Bearer`; it cannot attach custom
  // headers, so any auth proxy in front of the server must let /v8/* through.
  "remoteCache": {
    "timeout": 60,
    "uploadTimeout": 120,
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
    },
    // ^build, not nothing - but NOT because anything resolves through dist/.
    // In-repo every @bc-solutions-coder/* exports map points at src/ (dist/
    // appears only in publishConfig.exports, applied at pack time), so these
    // tasks read dependency SOURCE and run fine with no dist/ on disk at all.
    // The dependency is here for the HASH: a task's key folds in the keys of
    // the tasks it dependsOn, so ^build is what makes an edit under
    // packages/*/src invalidate every dependent. Measured both ways - remove
    // it, touch packages/sdk/src, and wallow-web:typecheck comes back FULL
    // TURBO on the stale result.
    "typecheck": {
      "dependsOn": ["^build"],
    },
    "test": {
      "dependsOn": ["^build"],
    },
    // No ^build here, deliberately, unlike the three above. dev is cache:
    // false, so it has no hash to protect, and the resolution argument never
    // applied: with all 11 packages/*/dist moved off disk, both apps still
    // boot and serve, executing package source (a thrown stack lands in
    // packages/sdk/src/server/config.ts). Depending on ^build would only make
    // a fresh clone pay for 11 library builds that nothing then reads.
    "dev": {
      "cache": false,
      "persistent": true,
    },
  },
}
