  "dependencies": {
    "@bc-solutions-coder/auth": "workspace:*",
    "@bc-solutions-coder/forms": "workspace:*",
    "@bc-solutions-coder/query": "workspace:*",
    "@bc-solutions-coder/sdk": "workspace:*",
    "@bc-solutions-coder/styles": "workspace:*",
    "@bc-solutions-coder/testing": "workspace:*",
    "@bc-solutions-coder/ui": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.32",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "redis": "^4.7.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
