{
  "name": "@bc-solutions-coder/wallow-web",
  "version": "0.0.0",
  "private": true,
  "description": "Wallow web frontend (TanStack Start + BFF SDK)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
