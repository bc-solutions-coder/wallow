# The application env block from the client registration reveal, verbatim.
# Register a client under your organization in wallow-web (Clients -> Register),
# copy the reveal's env block, and paste it over these eight lines.
OIDC_ISSUER=http://localhost:5001
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:3010/bff/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3010/
OIDC_SCOPES=openid profile email offline_access users.read
BFF_API_BASE_URL=http://localhost:5001
COOKIE_PASSWORD=change-me-to-at-least-32-characters!!

# Server-side session store. Optional locally (sealed-cookie sessions work for a
# single process), REQUIRED in production: back-channel logout and secret
# rotation can only revoke sessions the server holds.
REDIS_URL=redis://localhost:6379

# Service account for anonymous server-to-server calls (POST /contact). A
# SEPARATE registration with its own reveal — leave unset to disable the route.
#OIDC_SERVICE_CLIENT_ID=sa-your-service-account
#OIDC_SERVICE_CLIENT_SECRET=your-service-secret
#OIDC_SERVICE_SCOPES=inquiries.write

# Local-only: session cookies default to Secure, which browsers drop over plain
# http. NEVER set this in production.
#COOKIE_SECURE=false
