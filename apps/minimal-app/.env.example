# PROTOTYPE — this file IS the one-time reveal's env block, verbatim.
# Register an application in your organization on wallow.dev, copy the block
# it shows you here, and add the two deployment lines at the bottom.

# ---- pasted from the reveal (application) ----------------------------------
OIDC_ISSUER=https://wallow.dev/api
OIDC_CLIENT_ID=app-<org>-<name>
OIDC_CLIENT_SECRET=<shown once>
OIDC_REDIRECT_URI=https://example.com/bff/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://example.com/
OIDC_SCOPES=openid profile email offline_access
BFF_API_BASE_URL=https://wallow.dev/api
COOKIE_PASSWORD=<openssl rand -base64 32>

# ---- pasted from the reveal (service account, optional) --------------------
# Only if your server must call the API with no user signed in (this example's
# POST /contact). Register a service account in the same organization.
#OIDC_SERVICE_CLIENT_ID=sa-<org>-<name>
#OIDC_SERVICE_CLIENT_SECRET=<shown once>
#OIDC_SERVICE_SCOPES=inquiries.write

# ---- yours ------------------------------------------------------------------
# Server-side sessions. Required in production and for back-channel logout;
# unset it and the SDK falls back to a sealed-cookie session (single replica,
# dev only).
REDIS_URL=redis://localhost:6379
# Plain-HTTP local dev only: browsers drop `Secure` cookies on http://localhost.
#COOKIE_SECURE=false
