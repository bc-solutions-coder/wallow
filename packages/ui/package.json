{
  "name": "@bc-solutions-coder/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Wallow shared browser-only React component library",
  "files": [
    "dist",
    "source.css"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/components/*/index.ts",
      "import": "./src/components/*/index.ts"
    },
    "./source.css": "./source.css"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/components/*/index.d.ts",
        "import": "./dist/components/*/index.js"
      },
      "./source.css": "./source.css"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@bc-solutions-coder/config": "workspace:*",
    "@bc-solutions-coder/styles": "workspace:*",
    "@bc-solutions-coder/testing": "workspace:*",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@tanstack/react-router": "^1.170.18",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "storybook": "^10.5.5",
    "typescript": "catalog:tooling",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.18",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  }
}
