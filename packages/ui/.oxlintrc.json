{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  // The `wallow` plugin is REGISTERED once, at the repo root. A nested config
  // inherits that registration through `extends`, so this file only ENABLES
  // rules and names their options. See `packages/lint/CLAUDE.md`.
  "rules": {
    "react/jsx-props-no-spreading": "off",
    // The catalog DEFINES the primitives three of these rules police, so each is
    // switched on here and narrowed by a scoped override below rather than left
    // off wholesale — a recipe is the one place a colour decision is written
    // down, which makes it the place a fork-unreachable colour matters most.
    //
    // `text-heading-variant` names `h2: subheading` (the catalog-wide 20px card
    // heading) but no `h1` entry: `PageHeader` legitimately opens the page's one
    // level-1 heading at `variant="title"`. Every level still has to NAME a
    // variant, which is the check that matters here — `Text` derives a much
    // larger step from `as` alone.
    "wallow/no-hand-rolled-mutation": "error",
    "wallow/no-sidebar-inversion": "error",
    // The one rule here that applies ONLY to specs: it bans `node:fs` in a
    // `*.test.*` file and self-gates on the filename, so it is stated once at this
    // level and stays silent over source. See `.claude/rules/TESTING.md`.
    "wallow/no-source-tests": "error",
    "wallow/no-tinted-text": "error",
    "wallow/text-heading-variant": ["error", { "levels": { "h2": "subheading" } }],
    "wallow/zone-dag": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "no-magic-numbers": ["warn", { "ignore": [0, 1] }]
      }
    },
    {
      "files": ["src/components/drawer/drawer.styles.ts"],
      "rules": {
        // `drawerIndentBackgroundRecipe` is the layer revealed behind the
        // shrinking app UI, and it FADES: `bg-foreground opacity-0` →
        // `data-[active]:opacity-100`. The alpha the rule allows elsewhere is a
        // fixed value baked into the utility, which a transition cannot animate
        // from — so this is the one bare `bg-foreground` in the repo that is not
        // the retired inversion. Scoped to the single recipe file rather than the
        // component folder so the drawer's other surfaces stay judged.
        "wallow/no-sidebar-inversion": "off"
      }
    },
    {
      "files": ["**/*.{test,stories}.{ts,tsx}"],
      "rules": {
        "no-magic-numbers": "off",
        "unicorn/prefer-dom-node-dataset": "off",
        "unicorn/prefer-number-coercion": "off",
        "unicorn/prefer-query-selector": "off",
        "unicorn/error-message": "off",
        "func-name-matching": "off",
        "react/jsx-max-depth": "off",
        // The same four the two apps relax for specs. Here the reason is sharper
        // than in a consumer: these files are where the catalog PROVES its
        // primitives, so the banned spellings are the subjects. `text.test.tsx`
        // renders a bare `<Text as="h1">` to measure the scale it derives, and
        // `drawer.test.tsx` asserts the recipe's own class strings.
        // `wallow/zone-dag` is deliberately NOT in this list — it judges a spec's
        // import edges exactly as it judges a product module's. Neither is
        // `wallow/no-source-tests`, which has nothing BUT specs to judge; turning it
        // off here would turn it off everywhere.
        "wallow/no-hand-rolled-mutation": "off",
        "wallow/no-sidebar-inversion": "off",
        "wallow/no-tinted-text": "off",
        "wallow/text-heading-variant": "off"
      }
    }
  ]
}
