{
  "name": "@bc-solutions-coder/testing",
  "version": "0.0.0",
  "private": true,
  "description": "Wallow shared vitest preset and browser-mode test utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    },
    "./sdk-harness": {
      "types": "./dist/sdk-harness.d.ts",
      "import": "./dist/sdk-harness.js"
    },
    "./render-with-wallow": {
      "types": "./dist/render-with-wallow.d.ts",
      "import": "./dist/render-with-wallow.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bc-solutions-coder/query": "workspace:*",
    "@bc-solutions-coder/sdk": "workspace:*",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.61.1",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "devDependencies": {
    "@tanstack/react-router": "catalog:start",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "typescript": "^5.6.0",
    "vite": "^8.1.4"
  },
  "peerDependencies": {
    "@tanstack/react-router": "catalog:start",
    "react": "catalog:react",
    "react-dom": "catalog:react"
  }
}
