{
  // Inherits the workspace-standard TypeScript semantics from the repo-root base
  // config (target/lib/module/moduleResolution/jsx/strict/isolatedModules/
  // verbatimModuleSyntax/...), like every other workspace member.
  //
  // This file used to redeclare those options with DIFFERENT values — `target`
  // and `lib` on ES2022 rather than ESNext, and no isolatedModules,
  // verbatimModuleSyntax, resolveJsonModule, forceConsistentCasingInFileNames or
  // jsx at all — so the package that every app compiles against was the one
  // package not held to the shared baseline. It compiles clean under the full
  // base semantics; the drift was inherited, not required.
  //
  // What stays local is `types: ["node"]`, which is what lets the BFF server
  // entry reach `node:*`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Typecheck only — no emit settings here on purpose; see tsconfig.base.json.
    "types": ["node"]
  },
  "include": ["src", "scripts"]
}
