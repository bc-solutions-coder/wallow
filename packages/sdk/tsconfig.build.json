{
  // Declaration-only build config. The package `build` script runs Vite library
  // mode for the JS bundle and then `tsc -p tsconfig.build.json` for the .d.ts
  // files; `tsc --emitDeclarationOnly` owns declarations because Vite's lib mode
  // emits none.
  //
  // `include` is narrowed to just the public entry points; tsc transitively
  // pulls in every real src file they import, but *.test.ts / scripts / root
  // *.config.ts stay out of the program, so no stray declaration files leak
  // into dist/. `server/passthrough.ts` is listed explicitly because nothing
  // imports it — deliberately, so a passthrough-only app never reaches the BFF
  // handler graph — and an unlisted entry emits no .d.ts at all. `rootDir` is
  // set explicitly to keep dist/ mirroring src/ (error TS5011 otherwise).
  //
  // This package's typescript devDependency tracks the rest of the workspace
  // (^5.6.0) rather than carrying its own pin: the SDK's OpenAPI codegen,
  // @hey-api/openapi-ts, declares peer `typescript: ^5.5.3` and drives the TS
  // programmatic API, so `generate` and src/runtime-config.test.ts (which
  // imports openapi-ts.config.ts) need a 5.x compiler. An SDK-local major-version
  // pin here would put the codegen outside its own supported range.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/index.ts",
    "src/server/index.ts",
    "src/server/passthrough.ts",
    "src/query/index.ts"
  ],
  "exclude": ["**/*.test.ts", "scripts", "**/*.config.ts"]
}
