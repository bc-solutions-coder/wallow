{
  "name": "@bc-solutions-coder/telemetry",
  "version": "0.1.0",
  "description": "Optional Wallow application logs and request telemetry",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bc-solutions-coder/wallow.git",
    "directory": "packages/telemetry"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      }
    },
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bc-solutions-coder/config": "workspace:*",
    "@bc-solutions-coder/logger": "workspace:*",
    "@bc-solutions-coder/testing": "workspace:*",
    "@grafana/faro-web-sdk": "2.11.0",
    "@types/node": "^24.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.61.1",
    "typescript": "catalog:tooling",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
