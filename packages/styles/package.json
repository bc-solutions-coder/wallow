{
  "name": "@bc-solutions-coder/styles",
  "version": "0.0.0",
  "description": "Wallow shared Tailwind v4 entry and branding-driven theme tokens",
  "files": [
    "dist",
    "styles.css",
    "assets"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./styles.css",
    "./assets": {
      "types": "./src/assets.ts",
      "import": "./src/assets.ts"
    },
    "./vite": {
      "types": "./src/vite.ts",
      "import": "./src/vite.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./styles.css",
      "./assets": {
        "types": "./dist/assets.d.ts",
        "import": "./dist/assets.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js"
      }
    },
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@bc-solutions-coder/config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "catalog:tooling",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
