{
  "name": "@bc-solutions-coder/env",
  "version": "0.0.0",
  "private": true,
  "description": "Wallow shared environment-derived addressing for Start apps (internal origin, base path, auth origin)",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./auth-origin": {
      "types": "./src/auth-origin.ts",
      "import": "./src/auth-origin.ts"
    },
    "./base-path": {
      "types": "./src/base-path.ts",
      "import": "./src/base-path.ts"
    },
    "./internal-origin": {
      "types": "./src/internal-origin.ts",
      "import": "./src/internal-origin.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./auth-origin": {
        "types": "./dist/auth-origin.d.ts",
        "import": "./dist/auth-origin.js"
      },
      "./base-path": {
        "types": "./dist/base-path.d.ts",
        "import": "./dist/base-path.js"
      },
      "./internal-origin": {
        "types": "./dist/internal-origin.d.ts",
        "import": "./dist/internal-origin.js"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@bc-solutions-coder/config": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "catalog:tooling",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
