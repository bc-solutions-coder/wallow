{
  "uid": "wallow-stack-health",
  "title": "Observability stack health",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health, missing means unknown",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway|alloy|loki|tempo|grafana|prometheus\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Ingestion refusals and failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(wallow_gateway_requests_total{status=~\"4..|5..\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Collector refused records",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) ({__name__=~\"otelcol_receiver_refused_.*\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Collector export failures and dropped records",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) ({__name__=~\"otelcol_exporter_(send_failed|enqueue_failed)_.*\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Collector queue occupancy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"otelcol_exporter_queue_(size|capacity)\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Gateway memory against limit",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wallow_gateway_working_set_bytes / wallow_gateway_memory_limit_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Filesystem used, quota verification required",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - wallow_storage_filesystem_available_bytes / wallow_storage_filesystem_size_bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN",
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Gateway active requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "wallow_gateway_active_requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "UNKNOWN"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Service RSS against container ceilings",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"grafana\"} / 536870912 or process_resident_memory_bytes{job=~\"alloy|tempo|prometheus\"} / 1073741824 or process_resident_memory_bytes{job=\"loki\"} / 1342177280"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "UNKNOWN",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
