# Environment Configuration
# Copy to .env and modify for your environment

# Project
COMPOSE_PROJECT_NAME=wallow

# PostgreSQL
POSTGRES_USER=wallow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=wallow

# Valkey
VALKEY_PASSWORD=changeme
# Cache size cap (allkeys-lru eviction once reached)
VALKEY_MAXMEMORY=256mb

# GarageHQ (S3-compatible object storage)
# HAZARD: on boot, if a Garage key named GARAGE_KEY_NAME already exists in the cluster
# volume with an ID that does not match GARAGE_ACCESS_KEY, the entrypoint deletes and
# reimports it. Leaving these as the literal 'changeme' placeholder is safe against an
# EXISTING/shared Garage volume — the entrypoint refuses to delete a real key for a
# value that isn't shaped like one — but do not reuse 'changeme' as a real credential.
GARAGE_KEY_NAME=wallow-dev
GARAGE_ACCESS_KEY=changeme
GARAGE_SECRET_KEY=changeme
GARAGE_BUCKET=wallow-files

# Garage cluster tuning. The image has no committed garage.toml — the entrypoint
# renders garage.toml.template through envsubst at startup, so these are the knobs.
# The S3 and admin ports are deliberately NOT among them: they are fixed at 3900/3903
# in docker-compose.yml, which is also what the host port mappings hardcode.
GARAGE_REGION=us-east-1
# The two below are cluster secrets. Their defaults are literals committed in
# docker-compose.yml, which is fine for a single-node dev stack on localhost and is
# NOT fine for anything reachable by another machine — set both if that is you.
# GARAGE_RPC_SECRET=<64 hex chars; default is 0123456789abcdef repeated four times>
# GARAGE_ADMIN_TOKEN=wallow-admin-token

# Grafana
GF_ADMIN_PASSWORD=changeme

# Containerised E2E stack (docker-compose.test.yml — driven by scripts/e2e.sh).
# Every knob defaults to the classic fixed value when the compose file is run by
# hand; scripts/e2e.sh exports per-run values (free ports, a per-run image tag)
# so concurrent runs stay isolated (Wallow-joo0). Export one before running the
# script to pin it.
# E2E_IMAGE_TAG=test
# E2E_API_PORT=5050
# E2E_AUTH_PORT=5051
# E2E_WEB_PORT=5053
# E2E_BFF_PORT=3003
# E2E_POSTGRES_PORT=5442
# E2E_VALKEY_PORT=6389
# E2E_MAILPIT_SMTP_PORT=1035
# E2E_MAILPIT_HTTP_PORT=8035
# E2E_GARAGE_S3_PORT=3910
# E2E_GARAGE_ADMIN_PORT=3913
# The seeder's Admin__Email override. scripts/e2e.sh exports it EMPTY for the
# initial seed (no admin is bootstrapped, so the wallow-auth first-run journey
# exercises the /setup page), then restores this default for its second seeder
# pass. Unset, the compose default keeps seed.json's admin.
# E2E_SEED_ADMIN_EMAIL=admin@wallow.dev
