# openssl rand -hex 32
TURBO_TOKEN=
# openssl rand -hex 32 (must decode to >= 32 bytes)
TURBO_REMOTE_CACHE_SIGNATURE_KEY=
# The address the cache listens on. Set it to this host's tailscale IP
# (`tailscale ip -4`) so only tailnet peers can reach it; unset, the listener
# stays on loopback and nothing remote can connect.
# TURBO_CACHE_BIND_ADDR=
