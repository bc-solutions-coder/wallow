# Environment for docker-compose.pangolin.yml — the standalone Pangolin edge
# stack (the newt tunnel client split out of the production stack for stack
# managers where profile flags are awkward). Copy to .env.pangolin and fill in.
# Nothing here is shared with the main stack's .env.production.

# The main production stack's network, as `docker network ls` prints it.
# Compose names it <project>_wallow; with COMPOSE_PROJECT_NAME=wallow (the
# .env.production.example default) that is wallow_wallow.
WALLOW_NETWORK=wallow_wallow

# All three come from the site's config in the Pangolin dashboard.
PANGOLIN_ENDPOINT=https://pangolin.example.com
NEWT_ID=CHANGE_ME
NEWT_SECRET=CHANGE_ME
