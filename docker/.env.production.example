# =============================================================================
# Wallow Production Environment
# =============================================================================
# Do not copy this file by hand. From the repo root:
#
#   pnpm secrets:prod     # -> docker/.env.production, mode 600
#
# That is scripts/prod-secrets.sh. It writes a copy of this file with all 13
# generatable secrets replaced by fresh random values of the right shape, and
# refuses to run if docker/.env.production already exists. It does NOT invent
# your SMTP password or your domain — it prints what it left for you. Then:
#
#   cd docker
#   docker compose -f docker-compose.production.yml --env-file .env.production up --build
#
# Every secret below except GF_ADMIN_PASSWORD fails closed: leave it unset and
# `docker compose` aborts naming the variable, rather than starting insecure.
#
# Generating one by hand:
#   openssl rand -hex 32      # general passwords / signing keys
#   openssl rand -hex 12      # Garage access key ID (24 hex chars)
#
# Use -hex, NOT -base64. Base64 output can contain '+', '/' and '=', and several
# of these values are interpolated into URLs by docker-compose.production.yml —
# VALKEY_PASSWORD lands in wallow-web's REDIS_URL as
# redis://:${VALKEY_PASSWORD}@valkey:6379, where an unescaped '/' or '@' silently
# truncates the host and the BFF fails to reach Valkey. Hex is URL-safe, and
# `openssl rand -hex 32` yields 64 characters, comfortably over every minimum
# below.
# =============================================================================

# -----------------------------------------------------------------------------
# PROJECT
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=wallow

# -----------------------------------------------------------------------------
# CONTAINER IMAGES (GHCR)
# Use "latest" for rolling, or pin to a semver tag (e.g. 1.2.3)
# -----------------------------------------------------------------------------
VERSION=latest

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_USER=wallow
# Generate: openssl rand -hex 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=wallow

# -----------------------------------------------------------------------------
# VALKEY (Redis-compatible cache + SignalR backplane)
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
VALKEY_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# GARAGEHQ (S3-compatible object storage)
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME
# Generate: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=CHANGE_ME
# HAZARD: on boot, if a Garage key named GARAGE_KEY_NAME already exists in the cluster
# volume with an ID that does not match GARAGE_ACCESS_KEY, the entrypoint deletes and
# reimports it. Deploying against an EXISTING Garage volume with an unedited CHANGE_ME
# here would normally destroy the real key — the entrypoint now refuses to delete when
# the value isn't shaped like a real key ID, but you must still set real credentials
# before going live; never reuse CHANGE_ME as a real key.
# Generate the ID as 'GK' + `openssl rand -hex 12` (must be 'GK' + exactly 24 hex chars)
GARAGE_ACCESS_KEY=CHANGE_ME
# Generate: openssl rand -hex 32  (must be exactly 64 hex chars)
GARAGE_SECRET_KEY=CHANGE_ME
GARAGE_KEY_NAME=wallow
GARAGE_BUCKET=wallow-files
GARAGE_REGION=us-east-1
# There is deliberately no GARAGE_S3_PORT / GARAGE_ADMIN_PORT here. Garage publishes
# nothing to the host in the production stack — every consumer reaches it as
# garage:3900 over the private bridge — so those ports are fixed in the compose file.

# -----------------------------------------------------------------------------
# SMTP
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USE_SSL=true
SMTP_USERNAME=emailapikey
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_ADDRESS=noreply@wallow.dev
SMTP_FROM_NAME=Wallow

# -----------------------------------------------------------------------------
# IDENTITY / JWT SIGNING KEY
# -----------------------------------------------------------------------------
# Generate: openssl rand -hex 48
IDENTITY_SIGNING_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# OPENIDDICT CERTIFICATES
# These passwords protect the .pfx files generated on first API startup.
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
OPENIDDICT_SIGNING_CERT_PASSWORD=CHANGE_ME
OPENIDDICT_ENCRYPTION_CERT_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# OPENIDDICT TRANSPORT SECURITY
# Outside Development the OIDC endpoints require HTTPS. This stack terminates TLS
# at the reverse proxy and the BFF resolves discovery over the private Docker
# network (http://wallow-api:8080), so plain HTTP has to be allowed here.
# Set to false only if Kestrel serves HTTPS directly. Must be true or false.
# -----------------------------------------------------------------------------
OPENIDDICT_ALLOW_PLAIN_HTTP_ENDPOINTS=true

# -----------------------------------------------------------------------------
# PRODUCTION SEED FILE (used by wallow-seeder container)
# -----------------------------------------------------------------------------
# Host path to seed.production.json, bind-mounted into the seeder at
# /app/seed.production.json. This file is gitignored (seed.*.json), so it does
# NOT travel with the repo — you must place it on the server yourself.
# Leave unset to use ./seed.production.json (next to this compose file), or set
# an absolute path if you store it elsewhere on the host.
SEED_FILE_HOST_PATH=/data/seed/seed.production.json

# -----------------------------------------------------------------------------
# ADMIN BOOTSTRAP (used by wallow-seeder container)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@wallow.dev
# Generate: choose a strong password (min 12 chars, mixed case + symbols)
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# -----------------------------------------------------------------------------
# OIDC CLIENT: Wallow.Web (Dashboard) (used by wallow-seeder container — overrides seed.json defaults)
# The client secret here must match what wallow-web is configured with.
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
OIDC_CLIENT_ID=wallow-web-client
OIDC_CLIENT_SECRET=CHANGE_ME

# -----------------------------------------------------------------------------
# WALLOW-WEB BFF SESSION COOKIE
# Session-cookie seal password for wallow-web's BFF (iron-webcrypto). 32+ chars.
# Generate: openssl rand -hex 32
# -----------------------------------------------------------------------------
BFF_COOKIE_PASSWORD=CHANGE_ME_32_PLUS_CHARACTER_SECRET

# ROTATING THAT PASSWORD WITHOUT LOGGING EVERYONE OUT
# Changing BFF_COOKIE_PASSWORD alone invalidates every signed-in session: the new
# value cannot unseal cookies sealed with the old one. BFF_COOKIE_PASSWORDS is the
# overlap window. It is a JSON object of key ID to secret whose FIRST key seals new
# cookies while every other key stays valid for unsealing, so both generations of
# cookie work at once. Leave it unset and the single password above is used.
#
#   1. Generate a new secret and PREPEND it under a fresh key ID:
#        BFF_COOKIE_PASSWORDS='{"k2":"<new 64-hex>","k1":"<the current value>"}'
#   2. Redeploy. New logins seal with k2; existing cookies still unseal with k1.
#   3. Wait longer than SESSION_TTL_SECONDS (default 86400 = 24h) so every k1 cookie
#      has expired, then drop k1 and redeploy again.
#
# Each secret must be 32+ characters, and each key ID must be letters, digits or
# underscores and not all digits — iron-webcrypto rejects other IDs, and the SDK
# validates the whole map at boot rather than failing mid-login.
# BFF_COOKIE_PASSWORDS={"k1":"CHANGE_ME_32_PLUS_CHARACTER_SECRET"}

# -----------------------------------------------------------------------------
# WALLOW-WEB BFF SESSION — the rest of the contract (all optional)
# Every one of these has a working default, so the shipped stack needs none of
# them set. They are listed because they reach a deployment regardless, and a
# fork that cannot see them here would have to read the SDK to learn they exist.
# An empty value means "use the default" for all five — not "set it to nothing".
# -----------------------------------------------------------------------------
# Both of the next two FAIL SECURE: only the literal string `false` clears them,
# so a typo leaves you secure rather than exposed. Clear them only if the stack
# is served over plain HTTP, which no internet-facing deployment should be.
# BFF_COOKIE_SECURE=true          # Secure attribute on the session cookie
# BFF_COOKIE_HOST_PREFIX=true     # __Host- prefix; also requires Secure

# Session cookie name. Default __Host-wallow_bff, or wallow_bff when either flag
# above is off. Set it when two Wallow deployments share one origin — __Host-
# forces path=/, so their cookies would otherwise collide on the name.
# BFF_COOKIE_NAME=__Host-wallow_bff

# How long a session lives, in whole seconds. Default 86400 (24 hours). This is
# also the wait in step 3 of the rotation above. A malformed value throws at
# boot instead of falling back, so a typo cannot quietly shorten sessions.
# BFF_SESSION_TTL_SECONDS=86400

# Space-separated OIDC scopes. Default: openid profile email offline_access.
# Dropping offline_access costs you refresh tokens, and with them the silent
# renewal that keeps a session alive to the TTL above.
# BFF_OIDC_SCOPES=openid profile email offline_access

# -----------------------------------------------------------------------------
# OIDC CLIENT: Additional clients (optional)
# Only SECRETS come from this file — compose injects them positionally as
# Clients__<index>__Secret, matching the "clients" array order in
# seed.production.json. Every non-secret property of an additional client
# (clientId, tenantName, redirectUris, scopes) is declared in that seed file,
# not here. Uncomment the ones whose seed indices you actually use.
# Generate secret: openssl rand -hex 32
# -----------------------------------------------------------------------------
# BCORDES_CLIENT_SECRET=CHANGE_ME        # seed index 1 — public-facing SPA client
# BCORDES_BFF_SECRET=CHANGE_ME           # seed index 2 — service account, client credentials
# BCORDES_BFF_AUTHCODE_SECRET=CHANGE_ME  # seed index 3 — BFF auth-code + PKCE client
#
# The values below are NOT read by compose or the seeder — they are a checklist
# of what you must set inside seed.production.json for such a client, kept here
# so the two files stay in sync. Editing them changes nothing on its own.
# BCORDES_CLIENT_ID=bcordes-dev-client   # -> clients[1].clientId
# BCORDES_TENANT_NAME=Bcordes            # -> clients[1].tenantName
# BCORDES_ADMIN_EMAIL=admin@bcordes.dev  # -> the tenant's admin user email
# BCORDES_PUBLIC_URL=https://bcordes.dev # -> origin for clients[1].redirectUris

# -----------------------------------------------------------------------------
# PUBLIC URLS (what browsers see — used for OIDC, CORS, redirects)
# Path-based routing: all services live under wallow.dev
#   wallow.dev/api  -> API
#   wallow.dev/auth -> Auth
#   wallow.dev      -> Web (dashboard)
# For local testing, use http://localhost:PORT values.
# -----------------------------------------------------------------------------
API_PUBLIC_URL=https://wallow.dev/api
AUTH_PUBLIC_URL=https://wallow.dev/auth
WEB_PUBLIC_URL=https://wallow.dev
# Cookie domain — all services share the same domain now.
# For local testing, use: localhost
COOKIE_DOMAIN=wallow.dev

# -----------------------------------------------------------------------------
# FORK LINKS (the outbound repository/docs links the apps render)
# Both are OPTIONAL: unset, each falls back to packages/styles/branding.json and
# then to the upstream Wallow URLs, so a fork that edited branding.json needs
# neither. Set them to point one deployment — a staging stack, a private mirror
# — somewhere else without rebuilding the images: they are read per request by
# the Node apps, never baked into a bundle.
# -----------------------------------------------------------------------------
# WALLOW_REPOSITORY_URL=https://github.com/acme/wallow-fork
# WALLOW_DOCS_URL=https://docs.acme.dev

# -----------------------------------------------------------------------------
# PATH BASE (for reverse-proxy path-based routing)
# The ingress forwards the FULL path and strips nothing; each app rebases itself.
# Set BOTH to empty strings if using subdomain routing instead.
#
# API_PATH_BASE  — ASP.NET Core strips this prefix via PathBase at runtime.
# AUTH_BASE_PATH — the Node wallow-auth app serves its SSR HTML, its assets and
#                  its /v1, /connect and /.well-known passthrough routes under
#                  this prefix. Unlike API_PATH_BASE this is a BUILD input, not a
#                  runtime one: `vite build` bakes it into every emitted asset
#                  URL, so compose passes it as a build arg to the wallow-auth
#                  image and a container started with a different value would
#                  still serve the prefix it was built with. Consequence: the
#                  prebuilt ghcr.io/bc-solutions-coder/wallow-auth image is built
#                  at ROOT, so path-based routing needs `up --build` here, not a
#                  plain `pull`. Subdomain routing can use the pulled image as-is.
# -----------------------------------------------------------------------------
API_PATH_BASE=/api
AUTH_BASE_PATH=/auth

# -----------------------------------------------------------------------------
# INGRESS (the caddy service — reference reverse proxy, owns :80/:443)
# Routing config: docker/caddy/Caddyfile.example. Copy it to caddy/Caddyfile,
# edit your copy (set your real domain, drop `auto_https off`), and point
# CADDYFILE_HOST_PATH at it so upstream merges never clobber your routing.
#
# Replacing Caddy with nginx/Traefik/an ALB? The contract is:
#   1. Forward the full path — strip NEITHER the /api nor the /auth prefix.
#   2. Send X-Forwarded-Proto: https. REQUIRED. The API builds its absolute OIDC
#      URLs (authorize, end_session, discovery) from it; without it every
#      redirect leaves as http:// and browsers drop the Secure session cookie.
#   3. Route /api/* -> API_PORT, /auth/* -> AUTH_PORT, everything else WEB_PORT
#      (all on 127.0.0.1 — see PORTS below), or straight to the container names
#      if your ingress shares the wallow network.
# -----------------------------------------------------------------------------
# CADDYFILE_HOST_PATH=./caddy/Caddyfile
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# PORTS (host port mapping)
# These are bound to 127.0.0.1 ONLY — the ingress above is what the network
# reaches, and it talks to the apps over the private wallow docker network. They
# are published purely so you can curl a single service while debugging:
#   curl -H 'Host: wallow.dev' http://127.0.0.1:8080/api/health
# -----------------------------------------------------------------------------
API_PORT=8080
AUTH_PORT=8081
WEB_PORT=8082

# -----------------------------------------------------------------------------
# GRAFANA (optional — enable with: --profile observability)
# Access at: http://localhost:3001
# Generate: openssl rand -hex 24
#
# Every other secret in this file fails closed — leave it unset and `docker compose`
# refuses to start rather than coming up insecure. This one CANNOT, and the reason is
# a Compose limitation: interpolation runs over the whole file before profiles are
# applied, so marking it required would abort startup for deployments that never
# enable the observability profile. Set it yourself whenever you use that profile.
# -----------------------------------------------------------------------------
GF_ADMIN_PASSWORD=CHANGE_ME

# Fraction of traces the API records and exports (0.0-1.0, parent-based).
# Raise toward 1.0 only for short debugging windows — 1.0 exports every request.
OTEL_TRACE_SAMPLING_RATIO=0.1
